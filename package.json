{
  "name": "@chikolokoy08/ph-toolkit",
  "version": "0.1.0",
  "description": "Validators, formatters, and PSGC address data for developers building apps for the Philippines.",
  "keywords": [
    "philippines",
    "psgc",
    "validation",
    "mobile-number",
    "tin",
    "zip-code",
    "peso",
    "address"
  ],
  "homepage": "https://github.com/chikolokoy08/ph-toolkit#readme",
  "bugs": "https://github.com/chikolokoy08/ph-toolkit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chikolokoy08/ph-toolkit.git"
  },
  "author": "Carlo Andro Mabugay",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./address": {
      "types": "./dist/address/index.d.ts",
      "import": "./dist/address/index.js",
      "require": "./dist/address/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "build:psgc": "tsx scripts/build-psgc.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "exceljs": "^4.4.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^5.0.1"
  }
}
